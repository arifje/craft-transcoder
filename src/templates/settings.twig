{# @var craft \craft\web\twig\variables\CraftVariable #}
{# @var settings \nystudio107\transcoder\models\Settings #}

{% import '_includes/forms' as forms %}
{% import 'transcoder/_includes/macros.twig' as macros %}

{{ forms.lightswitchField({
    label: 'Enable video encoding'|t('transcoder'),
    instructions: 'Allow Transcoder to encode videos from Twig calls and queued entry saves. Disable this to serve original videos while keeping other plugin helpers available.'|t('transcoder'),
    warning: macros.configWarning('enableVideoEncoding', 'transcoder'),
    id: 'enableVideoEncoding',
    name: 'enableVideoEncoding',
    on: settings.enableVideoEncoding,
}) }}

{{ forms.lightswitchField({
    label: 'Enable download file endpoint'|t('transcoder'),
    instructions: 'Allow anonymous frontend access to the Transcoder download endpoint. Only enable this if generated files are intended to be downloadable.'|t('transcoder'),
    warning: macros.configWarning('enableDownloadFileEndpoint', 'transcoder'),
    id: 'enableDownloadFileEndpoint',
    name: 'enableDownloadFileEndpoint',
    on: settings.enableDownloadFileEndpoint,
}) }}

{{ forms.lightswitchField({
    label: 'Queue videos on entry save'|t('transcoder'),
    instructions: 'Queue video encoding when entries are saved. This requires a working Craft queue runner for reliable background encoding.'|t('transcoder'),
    warning: macros.configWarning('queueVideosOnEntrySave', 'transcoder'),
    id: 'queueVideosOnEntrySave',
    name: 'queueVideosOnEntrySave',
    on: settings.queueVideosOnEntrySave,
}) }}
