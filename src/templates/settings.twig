{# @var craft \craft\web\twig\variables\CraftVariable #}
{# @var settings \nystudio107\transcoder\models\Settings #}

{% import '_includes/forms' as forms %}
{% import 'transcoder/_includes/macros.twig' as macros %}

{% set watermarkAssetValue = settings.videoWatermarkAsset %}
{% set watermarkAssetIds = watermarkAssetValue is iterable ? watermarkAssetValue : (watermarkAssetValue ? [watermarkAssetValue] : []) %}
{% set watermarkAssets = watermarkAssetIds ? craft.assets.id(watermarkAssetIds).all() : [] %}
{% set watermarkPositions = [
    { label: 'Top left'|t('transcoder'), value: 'top-left' },
    { label: 'Top center'|t('transcoder'), value: 'top-center' },
    { label: 'Top right'|t('transcoder'), value: 'top-right' },
    { label: 'Center left'|t('transcoder'), value: 'center-left' },
    { label: 'Center'|t('transcoder'), value: 'center' },
    { label: 'Center right'|t('transcoder'), value: 'center-right' },
    { label: 'Bottom left'|t('transcoder'), value: 'bottom-left' },
    { label: 'Bottom center'|t('transcoder'), value: 'bottom-center' },
    { label: 'Bottom right'|t('transcoder'), value: 'bottom-right' },
] %}

<div id="tab-video">
    {{ forms.lightswitchField({
        label: 'Enable video encoding'|t('transcoder'),
        instructions: 'Allow Transcoder to encode uploaded videos and queue missing encodes from Twig/admin previews. Disable this to serve original videos while keeping other plugin helpers available.'|t('transcoder'),
        warning: macros.configWarning('enableVideoEncoding', 'transcoder'),
        id: 'enableVideoEncoding',
        name: 'enableVideoEncoding',
        on: settings.enableVideoEncoding,
    }) }}

    {{ forms.lightswitchField({
        label: 'Enable download file endpoint'|t('transcoder'),
        instructions: 'Allow anonymous frontend access to the Transcoder download endpoint. Only enable this if generated files are intended to be downloadable.'|t('transcoder'),
        warning: macros.configWarning('enableDownloadFileEndpoint', 'transcoder'),
        id: 'enableDownloadFileEndpoint',
        name: 'enableDownloadFileEndpoint',
        on: settings.enableDownloadFileEndpoint,
    }) }}

    {{ forms.lightswitchField({
        label: 'Auto crop black bars'|t('transcoder'),
        instructions: 'Detect black bars in uploaded videos and crop them before encoding. This is conservative and only crops when ffmpeg reports a stable, sensible crop area.'|t('transcoder'),
        warning: macros.configWarning('autoCropVideoBlackBars', 'transcoder'),
        id: 'autoCropVideoBlackBars',
        name: 'autoCropVideoBlackBars',
        on: settings.autoCropVideoBlackBars,
    }) }}

    {{ forms.lightswitchField({
        label: 'Queue videos on asset upload'|t('transcoder'),
        instructions: 'Queue video encoding and poster generation when a new video asset is uploaded. This requires a working Craft queue runner for reliable background processing.'|t('transcoder'),
        warning: macros.configWarning('queueVideosOnSave', 'transcoder'),
        id: 'queueVideosOnSave',
        name: 'queueVideosOnSave',
        on: settings.queueVideosOnSave or settings.queueVideosOnEntrySave,
    }) }}

    {{ forms.selectField({
        label: 'Video filename strategy'|t('transcoder'),
        instructions: 'Choose whether encoded video filenames should stay stable per source asset or include encoding options. Existing legacy filenames are still checked before a new encode is queued.'|t('transcoder'),
        warning: macros.configWarning('videoFilenameStrategy', 'transcoder'),
        id: 'videoFilenameStrategy',
        name: 'videoFilenameStrategy',
        value: settings.videoFilenameStrategy,
        options: [
            { label: 'Source asset'|t('transcoder'), value: 'source' },
            { label: 'Encoding options'|t('transcoder'), value: 'options' },
        ],
    }) }}
</div>

<div id="tab-watermark" class="hidden">
    {{ forms.lightswitchField({
        label: 'Enable video watermark'|t('transcoder'),
        instructions: 'Overlay the selected image on encoded videos. Existing encoded files are left alone until they are regenerated.'|t('transcoder'),
        warning: macros.configWarning('enableVideoWatermark', 'transcoder'),
        id: 'enableVideoWatermark',
        name: 'enableVideoWatermark',
        on: settings.enableVideoWatermark,
    }) }}

    {{ forms.elementSelectField({
        label: 'Watermark image'|t('transcoder'),
        instructions: 'Choose a PNG, JPG, or SVG asset to overlay on encoded videos.'|t('transcoder'),
        warning: macros.configWarning('videoWatermarkAsset', 'transcoder'),
        id: 'videoWatermarkAsset',
        name: 'videoWatermarkAsset',
        elementType: 'craft\\elements\\Asset',
        elements: watermarkAssets,
        sources: '*',
        criteria: {
            kind: ['image'],
        },
        limit: 1,
        viewMode: 'list',
    }) }}

    {{ forms.textField({
        label: 'Watermark width'|t('transcoder'),
        instructions: 'Width in pixels. Leave empty to use the original image width or preserve the ratio from height.'|t('transcoder'),
        warning: macros.configWarning('videoWatermarkWidth', 'transcoder'),
        id: 'videoWatermarkWidth',
        name: 'videoWatermarkWidth',
        value: settings.videoWatermarkWidth,
        type: 'number',
        min: 0,
        placeholder: 'auto',
        size: 6,
    }) }}

    {{ forms.textField({
        label: 'Watermark height'|t('transcoder'),
        instructions: 'Height in pixels. Leave empty to use the original image height or preserve the ratio from width.'|t('transcoder'),
        warning: macros.configWarning('videoWatermarkHeight', 'transcoder'),
        id: 'videoWatermarkHeight',
        name: 'videoWatermarkHeight',
        value: settings.videoWatermarkHeight,
        type: 'number',
        min: 0,
        placeholder: 'auto',
        size: 6,
    }) }}

    {{ forms.selectField({
        label: 'Watermark position'|t('transcoder'),
        instructions: 'Choose where the watermark should appear on the encoded video.'|t('transcoder'),
        warning: macros.configWarning('videoWatermarkPosition', 'transcoder'),
        id: 'videoWatermarkPosition',
        name: 'videoWatermarkPosition',
        value: settings.videoWatermarkPosition,
        options: watermarkPositions,
    }) }}

    <div class="field">
        <div class="heading">
            <label>{{ 'Watermark padding'|t('transcoder') }}</label>
            {{ macros.configWarning('videoWatermarkPaddingTop', 'transcoder') }}
        </div>
        <div class="instructions">
            <p>{{ 'Space around the watermark in pixels.'|t('transcoder') }}</p>
        </div>
        <div class="flex">
            {{ forms.text({
                id: 'videoWatermarkPaddingTop',
                name: 'videoWatermarkPaddingTop',
                value: settings.videoWatermarkPaddingTop,
                type: 'number',
                min: 0,
                size: 5,
                placeholder: 'top'|t('transcoder'),
            }) }}
            {{ forms.text({
                id: 'videoWatermarkPaddingRight',
                name: 'videoWatermarkPaddingRight',
                value: settings.videoWatermarkPaddingRight,
                type: 'number',
                min: 0,
                size: 5,
                placeholder: 'right'|t('transcoder'),
            }) }}
            {{ forms.text({
                id: 'videoWatermarkPaddingBottom',
                name: 'videoWatermarkPaddingBottom',
                value: settings.videoWatermarkPaddingBottom,
                type: 'number',
                min: 0,
                size: 5,
                placeholder: 'bottom'|t('transcoder'),
            }) }}
            {{ forms.text({
                id: 'videoWatermarkPaddingLeft',
                name: 'videoWatermarkPaddingLeft',
                value: settings.videoWatermarkPaddingLeft,
                type: 'number',
                min: 0,
                size: 5,
                placeholder: 'left'|t('transcoder'),
            }) }}
        </div>
    </div>

    {{ forms.textField({
        label: 'Watermark opacity'|t('transcoder'),
        instructions: 'Opacity percentage for the watermark image.'|t('transcoder'),
        warning: macros.configWarning('videoWatermarkOpacity', 'transcoder'),
        id: 'videoWatermarkOpacity',
        name: 'videoWatermarkOpacity',
        value: settings.videoWatermarkOpacity,
        type: 'number',
        min: 0,
        max: 100,
        size: 5,
    }) }}

    {{ forms.selectField({
        label: 'Watermark animation'|t('transcoder'),
        instructions: 'Optional subtle animation applied to the watermark.'|t('transcoder'),
        warning: macros.configWarning('videoWatermarkAnimation', 'transcoder'),
        id: 'videoWatermarkAnimation',
        name: 'videoWatermarkAnimation',
        value: settings.videoWatermarkAnimation,
        options: [
            { label: 'None'|t('transcoder'), value: 'none' },
            { label: 'Fade in'|t('transcoder'), value: 'fade-in' },
            { label: 'Fade out'|t('transcoder'), value: 'fade-out' },
            { label: 'Fade in and out'|t('transcoder'), value: 'fade-in-out' },
            { label: 'Slow rotate'|t('transcoder'), value: 'rotate' },
            { label: 'Small zoom pulse'|t('transcoder'), value: 'pulse' },
        ],
    }) }}

    {{ forms.lightswitchField({
        label: 'Reposition during video'|t('transcoder'),
        instructions: 'Move the watermark between selected positions while the video plays.'|t('transcoder'),
        warning: macros.configWarning('videoWatermarkReposition', 'transcoder'),
        id: 'videoWatermarkReposition',
        name: 'videoWatermarkReposition',
        on: settings.videoWatermarkReposition,
    }) }}

    {{ forms.textField({
        label: 'Reposition interval'|t('transcoder'),
        instructions: 'Seconds before the watermark moves to the next selected position.'|t('transcoder'),
        warning: macros.configWarning('videoWatermarkRepositionInterval', 'transcoder'),
        id: 'videoWatermarkRepositionInterval',
        name: 'videoWatermarkRepositionInterval',
        value: settings.videoWatermarkRepositionInterval,
        type: 'number',
        min: 1,
        size: 5,
    }) }}

    {{ forms.checkboxSelectField({
        label: 'Reposition positions'|t('transcoder'),
        instructions: 'Positions used when the watermark is moved during playback.'|t('transcoder'),
        warning: macros.configWarning('videoWatermarkRepositionPositions', 'transcoder'),
        id: 'videoWatermarkRepositionPositions',
        name: 'videoWatermarkRepositionPositions',
        values: settings.videoWatermarkRepositionPositions,
        options: watermarkPositions,
    }) }}
</div>

<div id="tab-video-posters" class="hidden">
    {{ forms.lightswitchField({
        label: 'Enable video posters'|t('transcoder'),
        instructions: 'Generate configured video poster images when videos are queued. Templates can read poster URLs without starting ffmpeg work.'|t('transcoder'),
        warning: macros.configWarning('enableVideoPosters', 'transcoder'),
        id: 'enableVideoPosters',
        name: 'enableVideoPosters',
        on: settings.enableVideoPosters,
    }) }}

    {{ forms.lightswitchField({
        label: 'Prevent black bars'|t('transcoder'),
        instructions: 'Add a blurred cover background behind fitted video posters, so portrait videos look better in wide poster formats.'|t('transcoder'),
        warning: macros.configWarning('preventVideoPosterBlackBars', 'transcoder'),
        id: 'preventVideoPosterBlackBars',
        name: 'preventVideoPosterBlackBars',
        on: settings.preventVideoPosterBlackBars,
    }) }}

    {{ forms.editableTableField({
        label: 'Video poster formats'|t('transcoder'),
        instructions: 'Define the poster images Transcoder should generate for each queued video. Leave width or height empty to use the original video dimension.'|t('transcoder'),
        warning: macros.configWarning('videoPosterFormats', 'transcoder'),
        id: 'videoPosterFormats',
        name: 'videoPosterFormats',
        cols: {
            handle: {
                type: 'singleline',
                heading: 'Handle'|t('transcoder'),
                placeholder: '16_9',
            },
            width: {
                type: 'number',
                heading: 'Width'|t('transcoder'),
                placeholder: 'auto',
            },
            height: {
                type: 'number',
                heading: 'Height'|t('transcoder'),
                placeholder: 'auto',
            },
            timeInSecs: {
                type: 'number',
                heading: 'Time'|t('transcoder'),
                placeholder: '3',
            },
        },
        rows: craft.transcoder.getVideoPosterFormatRows(),
        allowAdd: true,
        allowReorder: true,
        allowDelete: true,
    }) }}
</div>

<div id="tab-gif" class="hidden">
    {{ forms.lightswitchField({
        label: 'Enable GIF encoding'|t('transcoder'),
        instructions: 'Allow Transcoder to convert GIF assets to mp4 files.'|t('transcoder'),
        warning: macros.configWarning('enableGifEncoding', 'transcoder'),
        id: 'enableGifEncoding',
        name: 'enableGifEncoding',
        on: settings.enableGifEncoding,
    }) }}

    {{ forms.lightswitchField({
        label: 'Queue GIFs on asset upload'|t('transcoder'),
        instructions: 'Queue GIF encoding when a new GIF asset is uploaded instead of starting ffmpeg from templates.'|t('transcoder'),
        warning: macros.configWarning('queueGifsOnSave', 'transcoder'),
        id: 'queueGifsOnSave',
        name: 'queueGifsOnSave',
        on: settings.queueGifsOnSave or settings.queueGifsOnEntrySave,
    }) }}

    {{ forms.textField({
        label: 'GIF queue delay'|t('transcoder'),
        instructions: 'Seconds to delay each queued GIF job after the previous one. This spreads large batches over time and helps avoid overloading the server.'|t('transcoder'),
        warning: macros.configWarning('gifQueueDelaySeconds', 'transcoder'),
        id: 'gifQueueDelaySeconds',
        name: 'gifQueueDelaySeconds',
        value: settings.gifQueueDelaySeconds,
        type: 'number',
        min: 0,
        size: 5,
    }) }}
</div>
